{
  "name": "ozon-profit-hub",
  "version": "0.1.0",
  "description": "爆单ERP desktop shell for the hosted ERP service.",
  "author": "HJT888",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/start-with-build.mjs",
    "start:all": "node scripts/start-all.mjs",
    "electron": "electron .",
    "electron:local": "cross-env ELECTRON_REMOTE_URL=http://localhost:8788 electron .",
    "electron:cloud": "cross-env ELECTRON_REMOTE_URL=https://erp.hjt888.xyz electron .",
    "start:mysql": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-local-mysql.ps1 -StartApp",
    "start:mysql:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-local-mysql.ps1 -StartTunnel -StartApp",
    "start:server": "node scripts/start-server-local.mjs",
    "start:lan": "node scripts/start-server-lan.mjs",
    "dev": "node --watch scripts/start-server-local.mjs",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:file": "node --test --test-concurrency=1",
    "test:unit": "node scripts/run-test-group.mjs unit",
    "test:mysql": "node scripts/run-test-group.mjs mysql",
    "test:frontend": "node scripts/run-test-group.mjs frontend",
    "test:build": "node scripts/run-test-group.mjs build",
    "dev:frontend": "vite",
    "build:frontend": "node scripts/build-frontend-pipeline.mjs",
    "package:deploy": "node scripts/package-deploy.mjs",
    "deploy:ecs": "powershell -NoProfile -ExecutionPolicy Bypass -File ./deploy/linux/deploy-ecs.ps1",
    "release:tool": "node tools/release-manager/server.mjs",
    "package:plugin": "node ../scripts/package-baodan-plugin.mjs",
    "docs:api": "node scripts/generate-api-docs.mjs",
    "docs:api:check": "node scripts/check-api-docs.mjs",
    "check:health": "node scripts/health-check.mjs",
    "check:local-access": "node scripts/check-local-access.mjs",
    "check:deploy-preflight": "node scripts/check-deploy-preflight.mjs",
    "check:inventory-merge-risks": "node scripts/audit-inventory-merge-risks.mjs",
    "profile:http-pages": "node scripts/profile-mysql-pages.mjs",
    "check:ui": "node scripts/check-ui-design-system.mjs",
    "check:frontend-safety": "node scripts/check-frontend-safety.mjs",
    "check:encoding": "node scripts/check-text-encoding.mjs",
    "check:sql-bindings": "node scripts/check-sql-bindings.mjs",
    "probe:ozon-api": "node scripts/probe-ozon-seller-api.mjs",
    "benchmark:ozon-values": "node scripts/benchmark-ozon-attribute-values.mjs",
    "audit:ozon-finance-order": "node scripts/audit-ozon-finance-order.mjs",
    "audit:profit-variance": "node scripts/audit-profit-model-variance.mjs",
    "audit:code-health": "node scripts/audit-code-health.mjs",
    "audit:storage": "node scripts/audit-storage-baseline.mjs",
    "audit:storage:deep": "node scripts/audit-storage-baseline.mjs --deep",
    "archive:ai-draft-payloads": "node scripts/archive-ai-draft-save-payloads.mjs",
    "archive:ai-draft-payloads:write": "node scripts/archive-ai-draft-save-payloads.mjs --write",
    "compact:ai-draft-payloads": "node scripts/compact-archived-ai-draft-payloads.mjs",
    "backup:draft-media:oss": "node scripts/backup-listing-draft-media-to-oss.mjs",
    "backup:draft-media:oss:write": "node scripts/backup-listing-draft-media-to-oss.mjs --write",
    "repair:product-media:oss": "node scripts/repair-product-media-to-oss.mjs",
    "repair:product-media:oss:write": "node scripts/repair-product-media-to-oss.mjs --write",
    "migrate:tail-templates:oss": "node scripts/migrate-tail-templates-to-oss.mjs",
    "migrate:tail-templates:oss:write": "node scripts/migrate-tail-templates-to-oss.mjs --write",
    "audit:workspace-cleanup": "node scripts/audit-workspace-cleanup.mjs",
    "sync:ozon-finance-backfill": "node scripts/sync-ozon-finance-backfill.mjs",
    "db:init:mysql": "node scripts/init-mysql-schema.mjs",
    "db:optimize:mysql": "node scripts/optimize-mysql-indexes.mjs",
    "db:optimize:mysql:drop-redundant": "node scripts/optimize-mysql-indexes.mjs --drop-redundant",
    "db:backfill:order-history": "node scripts/backfill-order-status-history.mjs",
    "db:backfill:outbound-stock-locations": "node scripts/backfill-outbound-stock-locations.mjs",
    "repair:material-assets": "node scripts/materialize-material-assets.mjs",
    "repair:material-assets:write": "node scripts/materialize-material-assets.mjs --write",
    "repair:finance-profit": "node scripts/repair-finance-profit-facts.mjs",
    "repair:terminal-no-revenue-profits": "node scripts/repair-terminal-no-revenue-profits.mjs",
    "repair:draft-ai-media": "node scripts/repair-draft-ai-media.mjs",
    "repair:draft-ai-media:write": "node scripts/repair-draft-ai-media.mjs --write",
    "repair:listing-colors": "node scripts/repair-listing-color-fields.mjs",
    "repair:listing-colors:write": "node scripts/repair-listing-color-fields.mjs --write",
    "print-helper": "node scripts/local-print-helper.mjs",
    "build:desktop": "electron-builder --win nsis -c.electronDist=node_modules/electron/dist --publish never",
    "build:desktop:portable": "electron-builder --win portable -c.electronDist=node_modules/electron/dist --publish never"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "ali-oss": "^6.23.0",
    "bwip-js": "^4.11.1",
    "element-plus": "^2.11.5",
    "lucide-vue-next": "^1.0.0",
    "mysql2": "^3.22.3",
    "pdf-lib": "^1.17.1",
    "pinia": "^3.0.3",
    "playwright-core": "^1.55.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "cross-env": "^10.1.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.0.12",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.13",
    "vue": "^3.5.34",
    "vue-router": "^4.6.3"
  },
  "build": {
    "appId": "com.hjt888.ozonerp",
    "productName": "爆单ERP",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "artifactName": "Baodan-ERP-Setup-${version}.${ext}",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Baodan-ERP-Portable-${version}.${ext}"
    },
    "publish": {
      "provider": "generic",
      "url": "https://erp.hjt888.xyz/desktop-updates"
    }
  }
}
