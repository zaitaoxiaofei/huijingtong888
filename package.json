{
  "name": "ozon-profit-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:frontend": "vite",
    "build:frontend": "vite build",
    "docs:api": "node scripts/generate-api-docs.mjs",
    "docs:api:check": "node scripts/check-api-docs.mjs",
    "check:health": "node scripts/health-check.mjs",
    "check:ui": "node scripts/check-ui-design-system.mjs",
    "print-helper": "node scripts/local-print-helper.mjs",
    "backup:data": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/backup-data.ps1",
    "restore:data": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/restore-data.ps1"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.11.5",
    "pinia": "^3.0.3",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "vite": "^8.0.13",
    "vue": "^3.5.34",
    "vue-router": "^4.6.3"
  }
}
