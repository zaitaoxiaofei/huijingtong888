{
  "name": "爆单ERP 店铺数据分析插件",
  "description": "采集 Ozon Seller 后台分析数据并同步到爆单ERP",
  "version": "1.0.33",
  "manifest_version": 3,
  "permissions": ["storage", "webRequest", "scripting", "cookies"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://seller.ozon.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "爆单ERP 店铺数据分析插件",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://erp.hjt888.xyz/*"],
      "js": ["content/erp-instance.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://seller.ozon.ru/*"
      ],
      "js": [
        "content/erp-relay-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://seller.ozon.ru/*"
      ],
      "js": [
        "content/ozon.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://seller.ozon.ru/*"
      ],
      "js": [
        "content/erp-relay-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
