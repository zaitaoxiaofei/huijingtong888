{
  "manifest_version": 3,
  "name": "爆单ERP 统一采集插件",
  "description": "商品信息采集、前台数据展示与店铺分析同步，只需填写企业密钥",
  "version": "1.5.4",
  "permissions": ["activeTab", "alarms", "cookies", "scripting", "storage", "tabs", "webRequest"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://erp.hjt888.xyz/*",
    "https://seller.ozon.ru/*",
    "https://ozon.ru/*",
    "https://www.ozon.ru/*",
    "https://m.ozon.ru/*",
    "https://ozon.kz/*",
    "https://www.ozon.kz/*",
    "https://m.ozon.kz/*",
    "https://ozon.by/*",
    "https://www.ozon.by/*",
    "https://m.ozon.by/*",
    "https://*.ozon.ru/*",
    "https://*.ozon.kz/*",
    "https://*.ozon.by/*"
  ],
  "optional_host_permissions": [
    "https://ozon.ru/*",
    "https://www.ozon.ru/*",
    "https://m.ozon.ru/*",
    "https://ozon.kz/*",
    "https://www.ozon.kz/*",
    "https://m.ozon.kz/*",
    "https://ozon.by/*",
    "https://www.ozon.by/*",
    "https://m.ozon.by/*",
    "https://*.ozon.ru/*",
    "https://*.ozon.kz/*",
    "https://*.ozon.by/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/logo-16.png",
    "32": "assets/logo-32.png",
    "48": "assets/logo-48.png",
    "96": "assets/logo-96.png",
    "128": "assets/logo-128.png"
  },
  "action": {
    "default_title": "爆单ERP · 商品与店铺分析",
    "default_icon": {
      "16": "assets/logo-16.png",
      "32": "assets/logo-32.png",
      "48": "assets/logo-48.png",
      "96": "assets/logo-96.png",
      "128": "assets/logo-128.png"
    },
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/logo-16.png", "assets/logo-32.png", "assets/logo-48.png"],
      "matches": [
        "https://ozon.ru/*",
        "https://www.ozon.ru/*",
        "https://m.ozon.ru/*",
        "https://ozon.kz/*",
        "https://www.ozon.kz/*",
        "https://m.ozon.kz/*",
        "https://ozon.by/*",
        "https://www.ozon.by/*",
        "https://m.ozon.by/*",
        "https://*.ozon.ru/*",
        "https://*.ozon.kz/*",
        "https://*.ozon.by/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://seller.ozon.ru/*"],
      "js": ["analytics/content/erp-relay-page.js", "analytics/content/ozon.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://seller.ozon.ru/*"],
      "js": ["analytics/content/erp-relay-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://erp.hjt888.xyz/*"],
      "js": ["analytics/content/erp-instance.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://ozon.ru/*",
        "https://www.ozon.ru/*",
        "https://m.ozon.ru/*",
        "https://ozon.kz/*",
        "https://www.ozon.kz/*",
        "https://m.ozon.kz/*",
        "https://ozon.by/*",
        "https://www.ozon.by/*",
        "https://m.ozon.by/*",
        "https://*.ozon.ru/*",
        "https://*.ozon.kz/*",
        "https://*.ozon.by/*"
      ],
      "exclude_matches": ["https://seller.ozon.ru/*"],
      "js": ["erp-config.js", "collector.js", "content-core.js", "field-registry.js", "data-aggregator.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://seller.ozon.ru/*"],
      "js": ["seller-bridge-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://erp.hjt888.xyz/*"],
      "js": ["erp-bridge-content.js"],
      "run_at": "document_idle"
    }
  ]
}
