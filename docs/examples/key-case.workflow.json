{
  "schemaVersion": 1,
  "name": "TPU 汽车钥匙壳",
  "globalPrompt": "整套统一背景、光线和字体。保持产品形状、颜色、按键、开孔和数量。图片文案使用自然俄语，不添加平台标志。不得编造适配、材质、信号性能或认证。",
  "nodes": [
    {
      "id": "listing",
      "type": "listing",
      "label": "类目模板",
      "inputs": [],
      "templateId": 0
    },
    {
      "id": "name",
      "type": "field",
      "label": "产品名称",
      "inputs": [],
      "scope": "shared",
      "required": true,
      "defaultValue": "汽车钥匙保护壳",
      "help": "请填写已核实的产品信息"
    },
    {
      "id": "brand",
      "type": "field",
      "label": "品牌",
      "inputs": [],
      "scope": "shared",
      "required": true,
      "defaultValue": "",
      "help": "请填写已核实的产品信息"
    },
    {
      "id": "model",
      "type": "field",
      "label": "适配型号",
      "inputs": [],
      "scope": "shared",
      "required": true,
      "defaultValue": "",
      "help": "请填写已核实的产品信息"
    },
    {
      "id": "material",
      "type": "field",
      "label": "材质",
      "inputs": [],
      "scope": "shared",
      "required": true,
      "defaultValue": "TPU",
      "help": "请填写已核实的产品信息"
    },
    {
      "id": "color",
      "type": "field",
      "label": "颜色",
      "inputs": [],
      "scope": "variant",
      "required": true,
      "defaultValue": "",
      "help": "请填写已核实的产品信息"
    },
    {
      "id": "facts",
      "type": "field",
      "label": "已核实卖点与包装数量",
      "inputs": [],
      "scope": "shared",
      "required": true,
      "defaultValue": "",
      "help": "请填写已核实的产品信息"
    },
    {
      "id": "product",
      "type": "images",
      "label": "变体产品主图",
      "inputs": [],
      "scope": "variant",
      "count": 1,
      "required": true,
      "slots": [
        "当前变体的真实产品主图"
      ],
      "referenceRole": "product"
    },
    {
      "id": "key",
      "type": "images",
      "label": "适配钥匙图",
      "inputs": [],
      "scope": "shared",
      "count": 1,
      "required": true,
      "slots": [
        "全商品共同适配的钥匙外形"
      ],
      "referenceRole": "compatibility"
    },
    {
      "id": "style",
      "type": "images",
      "label": "视觉参考",
      "inputs": [],
      "scope": "shared",
      "count": 1,
      "required": false,
      "slots": [
        "整套共用的版式与风格参考"
      ],
      "referenceRole": "style"
    },
    {
      "id": "main",
      "type": "image",
      "label": "主图",
      "inputs": [
        "name",
        "brand",
        "model",
        "material",
        "color",
        "facts",
        "product",
        "key",
        "style"
      ],
      "role": "main",
      "ratio": "3:4",
      "prompt": "产品位于视觉中心，手机缩略图仍清晰。参考视觉图的构图与信息层级，明确展示已确认适配型号；只适配上传的钥匙，不扩大适配范围。"
    },
    {
      "id": "approve",
      "type": "approval",
      "label": "确认主图",
      "inputs": [
        "main"
      ]
    },
    {
      "id": "detail_1",
      "type": "image",
      "label": "适配特写",
      "inputs": [
        "name",
        "brand",
        "model",
        "material",
        "color",
        "facts",
        "product",
        "key",
        "approve"
      ],
      "role": "detail",
      "ratio": "3:4",
      "prompt": "突出适配钥匙外形和按键，清晰说明仅适配已确认型号。"
    },
    {
      "id": "detail_2",
      "type": "image",
      "label": "手持场景",
      "inputs": [
        "name",
        "brand",
        "model",
        "material",
        "color",
        "facts",
        "product",
        "key",
        "approve"
      ],
      "role": "detail",
      "ratio": "3:4",
