    },
    {
      "id": "detail_3",
      "type": "image",
      "label": "材质特写",
      "inputs": [
        "name",
        "brand",
        "model",
        "material",
        "color",
        "facts",
        "product",
        "key",
        "approve"
      ],
      "role": "detail",
      "ratio": "3:4",
      "prompt": "展示已确认材质与真实局部质感，不添加未经确认的性能承诺。"
    },
    {
      "id": "detail_4",
      "type": "image",
      "label": "覆盖防护",
      "inputs": [
        "name",
        "brand",
        "model",
        "material",
        "color",
        "facts",
        "product",
        "key",
        "approve"
      ],
      "role": "detail",
      "ratio": "3:4",
      "prompt": "展示真实包覆部位，不编造跌落测试或防护等级。"
    },
    {
      "id": "detail_5",
      "type": "image",
      "label": "按键贴合",
      "inputs": [
        "name",
        "brand",
        "model",
        "material",
        "color",
        "facts",
        "product",
        "key",
        "approve"
      ],
      "role": "detail",
      "ratio": "3:4",
      "prompt": "展示按键与开孔贴合，保持产品真实结构。"
    },
    {
      "id": "detail_6",
      "type": "image",
      "label": "购买须知",
      "inputs": [
        "name",
        "brand",
        "model",
        "material",
        "color",
        "facts",
        "product",
        "key",
        "approve"
      ],
      "role": "detail",
      "ratio": "3:4",
      "prompt": "清晰展示适配确认要点与包装数量；仅使用已确认事实。"
    },
    {
      "id": "copy",
      "type": "copy",
      "label": "文案生成",
      "inputs": [
        "name",
        "brand",
        "model",
        "material",
        "color",
        "facts"
      ],
      "target": "bundle",
      "prompt": "生成准确自然的俄语标题、标签和描述；只使用已确认产品事实，不编造卖点。"
    }
  ]
}
