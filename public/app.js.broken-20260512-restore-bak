      } else {
        status.textContent = `澧為噺鍚屾澶辫触锛?{error.message}`;
      }
    }
  } finally {
    state.orderSyncAbort = null;
    state.orderSyncCancelReason = "";
    if (timeoutTimer) window.clearTimeout(timeoutTimer);
