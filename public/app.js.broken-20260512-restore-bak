          <small>榛樿閲囪喘浠? ${money(product.purchase_cost)} / 榛樿杩愯垂: ${money(product.domestic_shipping)}</small>
          ${product.mapped_skus ? `<small>SKU: ${escape(product.mapped_skus)}</small>` : ""}
