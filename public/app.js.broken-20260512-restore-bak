  const initiatorRaw = String(row.cancel_initiator || "").trim() || cancelTypeLabel(row.cancel_type);
  const initiator = translateCancelInitiator(initiatorRaw);
  const reasonCn = translateCancelReason(reason);
  const isCancelled = orderMatchesStatus(row, "cancelled");
  if (!isCancelled && !reason && !initiator) return `<small class="muted">--</small>`;
  const loss = Number(row.cancel_loss_applies || 0) > 0;
  const stateText = loss ? "閫€璐? : "鍙栨秷";
  return `<div class="order-cancel-cell">
    <span>鍙栨秷鏂癸細${escape(initiator || "鏈煡")}</span>
    <small title="${escape(reason || "")}">${escape(reasonCn || reason || "鏈繑鍥炲彇娑堝師鍥?)}</small>
    ${tag(stateText, loss ? "red" : "green")}
  </div>`;
}

function cancelTypeLabel(value) {
  const key = String(value || "").toLowerCase();
  if (key === "client" || key === "buyer") return "涔板";
  if (key === "seller") return "鍗栧";
  if (key === "ozon" || key === "system") return "骞冲彴";
  if (key === "delivery") return "鐗╂祦";
  return "";
}

function translateCancelInitiator(value) {
  const text = String(value || "").trim();
  const lower = text.toLowerCase();
  if (!text) return "";
  if (lower === "client" || lower === "buyer" || lower.includes("泻谢懈械薪褌") || lower.includes("锌芯泻褍锌邪褌械谢")) return "涔板";
  if (lower === "seller" || lower.includes("锌褉芯写邪胁")) return "鍗栧";
  if (lower === "delivery" || lower.includes("褋谢褍卸斜邪 写芯褋褌邪胁泻懈")) return "鐗╂祦";
  if (lower === "ozon" || lower === "system" || lower.includes("ozon") || lower.includes("褋懈褋褌械屑")) return "骞冲彴";
  return text;
}

