  }
  if (savedUser && dialog.querySelector("[name='username']")) {
    dialog.querySelector("[name='username']").value = savedUser;
    dialog.querySelector("#loginPasswordInput")?.focus();
  } else {
    dialog.querySelector("[name='username']")?.focus();
  }
}

function closeLoginDialog() {
  const dialog = document.querySelector("#loginDialog");
  dialog.classList.remove("visible");
  // 寤惰繜闅愯棌锛岃鍔ㄧ敾瀹屾垚
  setTimeout(() => { dialog.style.display = "none"; }, 200);
  removeBackdrop();
}

async function handleLoginSubmit(event) {
  event.preventDefault();
  const form = event.target;
  const errorEl = document.querySelector("#loginError");
  const submitBtn = document.querySelector("#loginSubmitBtn");
  submitBtn.disabled = true;
  submitBtn.textContent = "鐧诲綍涓?..";
  errorEl.style.display = "none";
  try {
    const result = await api("/api/auth/login", {
      method: "POST",
      body: JSON.stringify({ username: form.elements.username.value, password: form.elements.password.value })
    });
    console.log("[鐧诲綍] API杩斿洖:", JSON.stringify(result));
    if (result.error) {
      throw new Error(result.error);
    }
    if (!result.token || !result.user) {
      console.error("[鐧诲綍] 寮傚父鍝嶅簲:", result);
      throw new Error("鏈嶅姟鍣ㄥ搷搴斿紓甯革紝璇锋鏌ユ帶鍒跺彴");
    }
    // 鈹€鈹€ 鐧诲綍鎴愬姛锛氫繚瀛樼姸鎬?鈹€鈹€
    state.authToken = result.token;
    localStorage.setItem("loginUsername", form.elements.username.value);
    if (document.querySelector("#loginRemember")?.checked) {
      localStorage.setItem("authToken", result.token);
    } else {
      localStorage.removeItem("authToken");
    }
    currentUser = result.user;
    state.currentUser = result.user;
    state.currentUserId = String(result.user.id);
    updateAuthUI(result.user);
    closeLoginDialog();
    // 鈹€鈹€ 鍚庣画鏁版嵁鍔犺浇锛堢嫭绔嬮敊璇鐞嗭級鈹€鈹€
    try { fillSelects(); } catch (e) { console.warn("[鐧诲綍鍚嶿 fillSelects寮傚父:", e); }
    try { await loadAll(); } catch (e) { console.warn("[鐧诲綍鍚嶿 loadAll寮傚父:", e); }
    try { restoreCurrentView(); } catch (e) { console.warn("[鐧诲綍鍚嶿 restoreCurrentView寮傚父:", e); }
  } catch (error) {
    errorEl.textContent = error.message || "鐧诲綍澶辫触锛岃妫€鏌ョ敤鎴峰悕鍜屽瘑鐮?;
    errorEl.style.display = "";
    form.elements.password.value = "";
    form.elements.password?.focus();
  } finally {
    submitBtn.disabled = false;
    submitBtn.textContent = "鐧?褰?;
  }
}

function handleAuthRequired() {
  state.authToken = "";
  localStorage.removeItem("authToken");
  currentUser = null;
  state.currentUser = null;
  updateAuthUI(null);
  openLoginDialog();
}

// 鏇存柊璁よ瘉鐩稿叧UI锛堜晶杈规爮鐢ㄦ埛鍚嶃€佹寜閽樉绀?闅愯棌銆侀厤缃〉璐︽埛淇℃伅锛?function updateAuthUI(user) {
  const nameEl = document.querySelector("#currentUserName");
  const logoutBtn = document.querySelector("#logoutBtn");
  if (!user) {
    if (nameEl) nameEl.textContent = "鏈櫥褰?;
    if (logoutBtn) logoutBtn.style.display = "none";
  } else {
    if (nameEl) nameEl.textContent = user.name || user.username || "宸茬櫥褰?;
    if (logoutBtn) logoutBtn.style.display = "";
  }
}

async function checkAuthSession() {
  if (!state.authToken) { openLoginDialog(); return false; }
  try {
    const user = await api("/api/auth/me");
    if (!user) { handleAuthRequired(); return false; }
    currentUser = user;
    state.currentUser = user;
    state.currentUserId = String(user.id);
    updateAuthUI(user);
    return true;
  } catch {
    handleAuthRequired();
    return false;
  }
}

async function doLogout() {
  try { await api("/api/auth/logout", { method: "POST" }); } catch {}
  handleAuthRequired();
  location.reload();
}

