    state.orderSyncAbort = new AbortController();
    state.orderSyncCancelReason = "";
    timeoutTimer = window.setTimeout(() => {
      state.orderSyncCancelReason = "timeout";
      state.orderSyncAbort?.abort();
    }, 5 * 60 * 1000);
    const result = await api("/api/sync/ozon/incremental", { method: "POST", body: JSON.stringify(body), signal: state.orderSyncAbort.signal });
    const failed = result.errors?.length ? `锛涘け璐?${result.errors.length} 娈礰 : "";
    const doneText = `鏈€杩?澶╂媺鍙栧畬鎴愶細鎷夊彇 ${result.fetched || 0} 鍗曪紝鏂板 ${result.inserted || 0} 鏉℃槑缁嗭紝鏇存柊 ${result.updated || 0} 鍗曪紝璇锋眰 ${result.requests || 0} 娆?{failed}`;
    state.orderSyncAbort = null;
    if (timeoutTimer) window.clearTimeout(timeoutTimer);
    timeoutTimer = null;
    setOrderSyncRefreshing(incrementalBtn, syncBtn, "姝ｅ湪鍒锋柊鍒楄〃...");
    if (status) status.textContent = `${doneText}锛涙鍦ㄥ埛鏂拌鍗曞垪琛?..`;
    await refreshAfterOrderSync();
    if (status) status.textContent = doneText;
  } catch (error) {
    if (status) {
      if (error.name === "AbortError") {
        status.textContent = state.orderSyncCancelReason === "timeout"
          ? "鏈鍚屾瓒呰繃 5 鍒嗛挓宸茶嚜鍔ㄥ仠姝€傚缓璁◢鍚庡啀璇曪紝鎴栧厛鍙媺鍙栧綋鍓嶈寖鍥淬€?
