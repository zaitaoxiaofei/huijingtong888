  return `<div class="order-logistics ${mode.key === "fbp" ? "fbp" : "fbs"}">
    <span class="logistics-tags">${tag(mode.label, mode.color)}</span>
    <small>${escape(mode.key === "fbs" ? "FBS self 鑷彂璐? : (warehouse || "FBP 浠撳彂"))}</small>
