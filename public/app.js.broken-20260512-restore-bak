    </div>
  `;
}

function inboundWaitDays(record) {
  if (!record?.created_at) return 0;
  const created = new Date(record.created_at);
  if (Number.isNaN(created.getTime())) return 0;
  return Math.floor((Date.now() - created.getTime()) / (1000 * 60 * 60 * 24));
}

