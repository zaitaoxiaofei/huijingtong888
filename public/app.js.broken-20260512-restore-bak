  </div>`;
}

function cleanLogisticsChannel(row) {
  const mode = logisticsMode(row);
  if (mode.key === "fbs") return "FBS 鑷彂璐?;
  return row.logistics_channel || row.delivery_method_name || row.tracking_number || row.warehouse_name || "FBP 浠撳彂";
