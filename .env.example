HOST=
PORT=8788
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ozon_erp
DB_USER=root
DB_PASSWORD=
DB_POOL_MIN=0
DB_POOL_MAX=10
APP_BASE_URL=http://localhost:8788
# Run automatic scheduled jobs only on the designated scheduler service.
# Defaults to true on port 8788 and false on other ports; manual "run now" remains available everywhere.
SCHEDULED_JOBS_ENABLED=true
BACKGROUND_ADVERTISING_SYNC_INTERVAL_MINUTES=15
BACKGROUND_ADVERTISING_TODAY_SYNC_TIMEOUT_MINUTES=25
# Public HTTPS base URL that Ozon can fetch uploaded listing media from.
# Leave empty for local editing only; formal Ozon submit will require this or a public APP_BASE_URL.
LISTING_MEDIA_PUBLIC_BASE_URL=
LISTING_PUBLISH_DRAFT_CONCURRENCY=2
LISTING_PUBLISH_SHOP_CONCURRENCY=2
LISTING_PUBLISH_BACKGROUND_CONCURRENCY=3
LISTING_PUBLISH_MEDIA_CHECK_CONCURRENCY=2
LISTING_MEDIA_PUBLIC_SYNC_TIMEOUT_MS=60000
LISTING_MEDIA_PUBLIC_SYNC_ATTEMPTS=3
LISTING_MEDIA_REACHABILITY_CACHE_TTL_MS=1800000
# Requests stream to temporary files; this cap controls simultaneous optimization/OSS writes.
LISTING_MEDIA_UPLOAD_MAX_CONCURRENCY=6
# New listing images and videos are written to OSS when enabled.
# Keep credentials server-side only. Never expose them in frontend code.
OSS_ENABLED=false
OSS_REGION=oss-cn-heyuan
OSS_BUCKET=hjt888-ozon-erp-private-2026
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_STS_TOKEN=
# Optional custom domain/CDN base URL. Leave empty to use the OSS HTTPS endpoint.
OSS_PUBLIC_BASE_URL=
# Durable upload storage. Relative paths are resolved from the running server directory.
# When the server runs from dist/deploy or dist/live, leaving this empty defaults to ../../uploads.
UPLOADS_ROOT=
SELLER_ANALYTICS_BROWSER_CHANNEL=chrome
SELLER_ANALYTICS_CHROME_PATH=
SELLER_ANALYTICS_PROXY_SERVER=
# Stable 32+ character secret used to encrypt uploaded Ozon Seller sessions in MySQL.
# Keep the same value across restarts and deployments. Rotating it requires retaining the old key until stores are rebound.
SELLER_ANALYTICS_AUTH_ENCRYPTION_KEY=

# Ozon category cache nightly sync, Asia/Shanghai time.
BACKGROUND_OZON_CATEGORY_SYNC_ENABLED=true
BACKGROUND_OZON_CATEGORY_SYNC_HOUR=1
BACKGROUND_OZON_CATEGORY_SYNC_MINUTE=10
BACKGROUND_OZON_CATEGORY_SYNC_CHECK_MINUTES=10
BACKGROUND_OZON_CATEGORY_SYNC_CATEGORY_LIMIT=120
BACKGROUND_OZON_CATEGORY_SYNC_VALUE_LIMIT=200
APP_SESSION_TTL_HOURS=72
SITE_ACCESS_PASSWORD=
SITE_ACCESS_COOKIE_NAME=erp_site_access
SITE_ACCESS_SESSION_HOURS=720
WECHAT_LOGIN_APP_ID=
WECHAT_LOGIN_APP_SECRET=
WECHAT_LOGIN_REDIRECT_URI=
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=8
HTTP_JSON_BODY_LIMIT_BYTES=26214400
HTTP_FORM_BODY_LIMIT_BYTES=1048576
BACKGROUND_TASK_FOREGROUND_IDLE_SECONDS=20
BACKGROUND_CRITICAL_JOB_MAX_DEFERRAL_SECONDS=300
SCHEDULED_JOBS_MAX_CONCURRENT=2
HEALTH_CHECK_USERNAME=
HEALTH_CHECK_PASSWORD=
BACKGROUND_ORDER_SYNC_INTERVAL_MINUTES=10
BACKGROUND_ORDER_SYNC_INITIAL_DELAY_SECONDS=180
BACKGROUND_ORDER_SYNC_DAYS=90
# Keep disabled until store chat capability and queued-message previews are verified.
OZON_CUSTOMER_MESSAGE_SEND_ENABLED=0
OZON_CUSTOMER_MESSAGE_MANUAL_TEST_ENABLED=0
# Maximum number of due automatic pickup reminders handled by one 10-minute scan.
OZON_CUSTOMER_MESSAGE_AUTO_BATCH_LIMIT=10
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
AI_IMAGE_OUTPUT_DIR=uploads/ai-generated
AI_CROP_OUTPUT_DIR=uploads/ai-cropped
# Global backpressure shared by every image workflow. Runtime memory and DB pressure can reduce it automatically.
AI_IMAGE_GLOBAL_CONCURRENCY_CAP=12
AI_IMAGE_TASK_CONCURRENCY_CAP=6
AI_SOURCE_IMAGE_CACHE_TTL_MS=900000
AI_SOURCE_IMAGE_CACHE_MAX_ENTRIES=32
AI_PROVIDER_REPOLL_DELAY_SECONDS=30
AI_VARIANT_PROVIDER_REPOLL_DELAY_MS=30000
# Persistent batch workers. These resume queued/running work after a service restart.
AI_VARIANT_DRAFT_SAVE_CONCURRENCY=8
AI_MATERIAL_OPTIMIZATION_CONCURRENCY=4

# MySQL runtime:
# DB_CLIENT=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=ozon_erp
# DB_USER=root
# DB_PASSWORD=replace-with-real-password
# DB_POOL_MIN=0
# DB_POOL_MAX=10

# For Cloudflare Tunnel mode, usually set:
# HOST=127.0.0.1
# APP_BASE_URL=https://erp.example.com
# APP_SESSION_TTL_HOURS=12
# SITE_ACCESS_PASSWORD=replace-with-a-long-random-password
# WECHAT_LOGIN_APP_ID=wx...
# WECHAT_LOGIN_APP_SECRET=replace-with-wechat-app-secret
# WECHAT_LOGIN_REDIRECT_URI=https://erp.example.com/api/auth/wechat/callback
# HEALTH_CHECK_USERNAME=health-check-user
# HEALTH_CHECK_PASSWORD=replace-with-a-strong-password

# Optional: add real Ozon credentials later.
# OZON_SHOP_MAIN_CLIENT_ID=
# OZON_SHOP_MAIN_API_KEY=
