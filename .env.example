HOST=
PORT=8788
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ozon_erp
DB_USER=root
DB_PASSWORD=
DB_POOL_MIN=0
DB_POOL_MAX=10
APP_BASE_URL=http://localhost:8788
# Public HTTPS base URL that Ozon can fetch uploaded listing media from.
# Leave empty for local editing only; formal Ozon submit will require this or a public APP_BASE_URL.
LISTING_MEDIA_PUBLIC_BASE_URL=

# Ozon category cache nightly sync, Asia/Shanghai time.
BACKGROUND_OZON_CATEGORY_SYNC_ENABLED=true
BACKGROUND_OZON_CATEGORY_SYNC_HOUR=1
BACKGROUND_OZON_CATEGORY_SYNC_MINUTE=10
BACKGROUND_OZON_CATEGORY_SYNC_CHECK_MINUTES=10
BACKGROUND_OZON_CATEGORY_SYNC_CATEGORY_LIMIT=120
BACKGROUND_OZON_CATEGORY_SYNC_VALUE_LIMIT=200
APP_SESSION_TTL_HOURS=72
SITE_ACCESS_PASSWORD=
SITE_ACCESS_COOKIE_NAME=erp_site_access
SITE_ACCESS_SESSION_HOURS=168
WECHAT_LOGIN_APP_ID=
WECHAT_LOGIN_APP_SECRET=
WECHAT_LOGIN_REDIRECT_URI=
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=8
HEALTH_CHECK_USERNAME=
HEALTH_CHECK_PASSWORD=
BACKGROUND_ORDER_SYNC_INTERVAL_MINUTES=60
BACKGROUND_ORDER_SYNC_INITIAL_DELAY_SECONDS=180
BACKGROUND_ORDER_SYNC_DAYS=90
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
AI_IMAGE_OUTPUT_DIR=uploads/ai-generated
AI_CROP_OUTPUT_DIR=uploads/ai-cropped

# MySQL runtime:
# DB_CLIENT=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=ozon_erp
# DB_USER=root
# DB_PASSWORD=replace-with-real-password
# DB_POOL_MIN=0
# DB_POOL_MAX=10

# For Cloudflare Tunnel mode, usually set:
# HOST=127.0.0.1
# APP_BASE_URL=https://erp.example.com
# APP_SESSION_TTL_HOURS=12
# SITE_ACCESS_PASSWORD=replace-with-a-long-random-password
# WECHAT_LOGIN_APP_ID=wx...
# WECHAT_LOGIN_APP_SECRET=replace-with-wechat-app-secret
# WECHAT_LOGIN_REDIRECT_URI=https://erp.example.com/api/auth/wechat/callback
# HEALTH_CHECK_USERNAME=health-check-user
# HEALTH_CHECK_PASSWORD=replace-with-a-strong-password

# Optional: add real Ozon credentials later.
# OZON_SHOP_MAIN_CLIENT_ID=
# OZON_SHOP_MAIN_API_KEY=
