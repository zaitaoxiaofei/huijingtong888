HOST=127.0.0.1
PORT=3000
APP_BASE_URL=https://erp.example.com

DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ozon_erp
DB_USER=ozon_app
DB_PASSWORD=replace-with-strong-password
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_QUEUE_LIMIT=50
DB_POOL_ACQUIRE_TIMEOUT_MS=15000

SCHEDULED_JOBS_ENABLED=false
# off keeps the current history behavior; shadow compares without skipping writes; enabled skips exact duplicates.
ORDER_HISTORY_DEDUPE_MODE=off
LISTING_PUBLISH_DRAFT_CONCURRENCY=2
LISTING_PUBLISH_SHOP_CONCURRENCY=2
LISTING_PUBLISH_BACKGROUND_CONCURRENCY=2
LISTING_PUBLISH_MEDIA_CHECK_CONCURRENCY=2

SITE_ACCESS_PASSWORD=replace-with-long-random-password
SITE_ACCESS_SESSION_HOURS=720
SELLER_ANALYTICS_AUTH_ENCRYPTION_KEY=replace-with-a-stable-random-32-character-secret
HEALTH_CHECK_USERNAME=health-check-user
HEALTH_CHECK_PASSWORD=replace-with-strong-password

OSS_ENABLED=true
OSS_REGION=oss-cn-heyuan
OSS_BUCKET=replace-with-bucket-name
OSS_ACCESS_KEY_ID=replace-on-server
OSS_ACCESS_KEY_SECRET=replace-on-server
OSS_STS_TOKEN=
OSS_PUBLIC_BASE_URL=
